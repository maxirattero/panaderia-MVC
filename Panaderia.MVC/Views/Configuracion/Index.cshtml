@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@model Panaderia.MVC.Models.ConfiguracionViewModel

@{
    ViewData["Title"] = "Configuración";
}
    <!-- Header Section -->
    <div class="row align-items-end mb-5 gy-4">
        <div class="col-md-7">
            <h1 class="display-6 fw-bold titulo-pagina mb-1">Configuración</h1>
            <p class="text-secondary m-0">Administra las categorías, formatos, tamaños y etiquetas del catálogo.</p>
        </div>
    </div>

    @if (TempData["EtiquetaError"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2">
            <span class="material-symbols-outlined">error</span>
            @TempData["EtiquetaError"]
        </div>
    }

    <div class="row g-4">

        <!-- Categorías -->
        <div class="col-lg-3 col-md-6">
            <div class="card-custom overflow-hidden">
                <div class="p-3 border-bottom">
                    <h5 class="fw-bold mb-0">Categorías</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-custom table-hover m-0">
                        <tbody>
                            @foreach (var categoria in Model.Categorias)
                            {
                                <tr>
                                    <td>@categoria.Nombre</td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Eliminar"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-id="@categoria.Id"
                                                data-nombre="@categoria.Nombre"
                                                data-delete-url="@Url.Action("EliminarCategoria", "Configuracion", new { id = categoria.Id })"
                                                data-token="@Antiforgery.GetAndStoreTokens(Context).RequestToken">
                                            <span class="material-symbols-outlined">delete</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="p-3 border-top">
                    <form asp-action="CrearCategoria" asp-controller="Configuracion" method="post">
                        @Html.AntiForgeryToken()
                        <div class="input-group">
                            <input type="text" name="nombre" class="form-control" placeholder="Nueva categoría..." />
                            <button type="submit" class="btn btn-mv-primary d-flex align-items-center gap-1">
                                <span class="material-symbols-outlined">add</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Formatos -->
        <div class="col-lg-3 col-md-6">
            <div class="card-custom overflow-hidden">
                <div class="p-3 border-bottom">
                    <h5 class="fw-bold mb-0">Formatos</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-custom table-hover m-0">
                        <tbody>
                            @foreach (var formato in Model.Formatos)
                            {
                                <tr>
                                    <td>@formato.Descripcion</td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Eliminar"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-id="@formato.Id"
                                                data-nombre="@formato.Descripcion"
                                                data-delete-url="@Url.Action("EliminarFormato", "Configuracion", new { id = formato.Id })"
                                                data-token="@Antiforgery.GetAndStoreTokens(Context).RequestToken">
                                            <span class="material-symbols-outlined">delete</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="p-3 border-top">
                    <form asp-action="CrearFormato" asp-controller="Configuracion" method="post">
                        @Html.AntiForgeryToken()
                        <div class="input-group">
                            <input type="text" name="descripcion" class="form-control" placeholder="Nuevo formato..." />
                            <button type="submit" class="btn btn-mv-primary d-flex align-items-center gap-1">
                                <span class="material-symbols-outlined">add</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Tamaños -->
        <div class="col-lg-3 col-md-6">
            <div class="card-custom overflow-hidden">
                <div class="p-3 border-bottom">
                    <h5 class="fw-bold mb-0">Tamaños</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-custom table-hover m-0">
                        <tbody>
                            @foreach (var tamano in Model.Tamanos)
                            {
                                <tr>
                                    <td>@tamano.Descripcion</td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Eliminar"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-id="@tamano.Id"
                                                data-nombre="@tamano.Descripcion"
                                                data-delete-url="@Url.Action("EliminarTamano", "Configuracion", new { id = tamano.Id })"
                                                data-token="@Antiforgery.GetAndStoreTokens(Context).RequestToken">
                                            <span class="material-symbols-outlined">delete</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="p-3 border-top">
                    <form asp-action="CrearTamano" asp-controller="Configuracion" method="post">
                        @Html.AntiForgeryToken()
                        <div class="input-group">
                            <input type="text" name="descripcion" class="form-control" placeholder="Nuevo tamaño..." />
                            <button type="submit" class="btn btn-mv-primary d-flex align-items-center gap-1">
                                <span class="material-symbols-outlined">add</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Etiquetas de tienda -->
        <div class="col-lg-3 col-md-6">
            <div class="card-custom overflow-hidden">
                <div class="p-3 border-bottom">
                    <h5 class="fw-bold mb-0">Etiquetas de tienda</h5>
                    <small class="text-secondary">Masa madre, Vegano, Sin gluten...</small>
                </div>
                <div class="table-responsive">
                    <table class="table table-custom table-hover m-0">
                        <tbody>
                            @foreach (var etiqueta in Model.Etiquetas)
                            {
                                <tr>
                                    <td>
                                        <span class="badge-tienda">
                                            <span class="material-symbols-outlined">@etiqueta.Icono</span>
                                            @etiqueta.Nombre
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Eliminar"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-id="@etiqueta.Id"
                                                data-nombre="@etiqueta.Nombre"
                                                data-delete-url="@Url.Action("EliminarEtiqueta", "Configuracion", new { id = etiqueta.Id })"
                                                data-token="@Antiforgery.GetAndStoreTokens(Context).RequestToken">
                                            <span class="material-symbols-outlined">delete</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="p-3 border-top">
                    <form asp-action="CrearEtiqueta" asp-controller="Configuracion" method="post">
                        @Html.AntiForgeryToken()
                        <div class="input-group">
                            <input type="hidden" name="icono" id="iconoEtiquetaSeleccionado" value="grain" />
                            <button type="button"
                                    class="btn btn-outline-secondary selector-icono-trigger"
                                    id="abrirSelectorIcono"
                                    data-bs-toggle="modal"
                                    data-bs-target="#selectorIconoModal"
                                    title="Elegir ícono">
                                <span class="material-symbols-outlined" id="previewIcono">grain</span>
                                <span class="visually-hidden">Elegir ícono</span>
                            </button>
                            <input type="text" name="nombre" class="form-control" placeholder="Nueva etiqueta..." maxlength="40" />
                            <button type="submit" class="btn btn-mv-primary d-flex align-items-center gap-1">
                                <span class="material-symbols-outlined">add</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>

<div class="modal fade" id="selectorIconoModal" tabindex="-1" aria-labelledby="selectorIconoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="selectorIconoModalLabel">Elegí un ícono</h5>
                    <small class="text-secondary">Catálogo completo de Material Symbols</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-column flex-sm-row gap-2 align-items-sm-center mb-3">
                    <div class="input-group flex-grow-1">
                        <span class="input-group-text"><span class="material-symbols-outlined">search</span></span>
                        <input type="search" class="form-control" id="buscarIcono" placeholder="Buscar un ícono..." autocomplete="off" />
                    </div>
                    <a class="btn btn-mv-secondary btn-sm text-nowrap" href="https://fonts.google.com/icons" target="_blank" rel="noopener noreferrer">
                        Catálogo de Google <span class="material-symbols-outlined">open_in_new</span>
                    </a>
                </div>
                <p class="text-secondary small mb-3" id="estadoIconos">Abrí el selector para cargar los íconos.</p>
                <div class="selector-iconos-grid" id="listaIconos" aria-live="polite"></div>
                <div class="text-center mt-3 d-none" id="contenedorMasIconos">
                    <button type="button" class="btn btn-mv-secondary" id="mostrarMasIconos">Mostrar más</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modal = document.getElementById('selectorIconoModal');
            const input = document.getElementById('iconoEtiquetaSeleccionado');
            const preview = document.getElementById('previewIcono');
            const search = document.getElementById('buscarIcono');
            const list = document.getElementById('listaIconos');
            const status = document.getElementById('estadoIconos');
            const moreContainer = document.getElementById('contenedorMasIconos');
            const more = document.getElementById('mostrarMasIconos');
            const pageSize = 120;
            let icons = [];
            let filteredIcons = [];
            let visibleCount = pageSize;
            let loaded = false;

            if (!modal || !input || !preview || !search || !list || !status || !moreContainer || !more) return;

            function normalizar(value) {
                return value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
            }

            function renderIcons() {
                const query = normalizar(search.value.trim());
                filteredIcons = query
                    ? icons.filter(icon => normalizar(`${icon.nombre} ${icon.categoria} ${icon.busqueda}`).includes(query))
                    : icons;

                const iconsToShow = filteredIcons.slice(0, visibleCount);
                list.replaceChildren();

                iconsToShow.forEach(icon => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = `selector-icono-item${icon.nombre === input.value ? ' seleccionado' : ''}`;
                    button.title = icon.nombre;
                    button.setAttribute('aria-label', `Elegir ${icon.nombre}`);

                    const symbol = document.createElement('span');
                    symbol.className = 'material-symbols-outlined';
                    symbol.textContent = icon.nombre;
                    button.append(symbol);

                    button.addEventListener('click', () => {
                        input.value = icon.nombre;
                        preview.textContent = icon.nombre;
                        bootstrap.Modal.getOrCreateInstance(modal).hide();
                    });
                    list.append(button);
                });

                status.textContent = filteredIcons.length
                    ? `${filteredIcons.length.toLocaleString('es-AR')} íconos disponibles. Mostrando ${iconsToShow.length.toLocaleString('es-AR')}.`
                    : 'No encontramos íconos con esa búsqueda.';
                moreContainer.classList.toggle('d-none', visibleCount >= filteredIcons.length);
            }

            async function loadIcons() {
                if (loaded) {
                    renderIcons();
                    return;
                }

                status.textContent = 'Cargando el catálogo completo de íconos...';
                try {
                    const response = await fetch('@Url.Action("IconosMaterialSymbols", "Configuracion")');
                    if (!response.ok) throw new Error('No se pudo cargar el catálogo.');

                    icons = await response.json();
                    loaded = true;
                    visibleCount = pageSize;
                    renderIcons();
                } catch {
                    status.textContent = 'No se pudo cargar el catálogo. Probá nuevamente en unos minutos.';
                }
            }

            modal.addEventListener('shown.bs.modal', loadIcons);
            search.addEventListener('input', () => {
                visibleCount = pageSize;
                renderIcons();
            });
            more.addEventListener('click', () => {
                visibleCount += pageSize;
                renderIcons();
            });
        })();
    </script>
}
