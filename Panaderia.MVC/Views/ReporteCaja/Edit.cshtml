@model Panaderia.MVC.Models.ReporteCajaFormViewModel
@using Panaderia.Models.Enums
@using Panaderia.MVC.Models
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Movimiento de caja";
    var cuentas = Html.GetEnumSelectList<CuentaCaja>().Where(x => x.Value != "0").ToList();
    var categorias = Html.GetEnumSelectList<CategoriaMovimiento>().Where(x => x.Value == "2" || x.Value == "4" || x.Value == "7");
}
<h1 class="display-6 fw-bold titulo-pagina mb-3">Movimiento de caja</h1>
<partial name="_Avisos" />
@if (Model.EsAutomatico)
{
    <div class="card-custom p-4 mb-4" style="max-width:800px">
        <p class="fw-bold fs-4">@CajaUi.Moneda(Model.Monto)</p><p>@Model.Descripcion</p>
        <p>@Model.Fecha.ToString("dd/MM/yyyy") · @CajaUi.Cuenta(Model.Cuenta)</p>
        <p class="text-muted mb-0">Se conserva el movimiento original para mantener la relación con el pedido, compra o cierre.</p>
    </div>
    @if (Model.Cuenta == CuentaCaja.SinClasificar)
    {
        <form asp-action="Clasificar" method="post" class="card-custom p-4 mb-4" style="max-width:800px">
            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
            <label for="cuentaClasificar" class="form-label">Cuenta del movimiento histórico</label>
            <select id="cuentaClasificar" name="cuenta" class="form-select mb-3" required><option value="">Elegir cuenta</option><option value="1">Efectivo</option><option value="2">Banco</option>@if(Model.Categoria != CategoriaMovimiento.Venta) { <option value="3">Reserva Mercado Pago</option> }</select>
            <button class="btn btn-mv-secondary">Guardar origen</button>
        </form>
    }
    @if (Model.IdPedido.HasValue)
    {
        <details class="card-custom p-4 mb-4" style="max-width:800px"><summary class="fw-semibold">Registrar devolución de dinero del pedido</summary>
            <form asp-action="Devolucion" method="post" class="mt-3">
                @Html.AntiForgeryToken()<input type="hidden" name="idPedido" value="@Model.IdPedido" /><input type="hidden" name="clave" value="@Guid.NewGuid()" />
                <p>Registrá únicamente el dinero que efectivamente devolviste. Se conserva el cobro original y se actualiza lo cobrado del pedido.</p>
                <label for="montoDevolucion" class="form-label">Importe devuelto</label><input id="montoDevolucion" name="monto" type="number" min="0.01" step="0.01" class="form-control mb-3" required />
                <label for="cuentaDevolucion" class="form-label">Sale de</label><select id="cuentaDevolucion" name="cuenta" class="form-select mb-3" required><option value="">Elegir cuenta</option><option value="1">Efectivo</option><option value="2">Banco</option></select>
                <label for="motivoDevolucion" class="form-label">Motivo</label><input id="motivoDevolucion" name="motivo" maxlength="500" class="form-control mb-3" required />
                <button class="btn btn-mv-primary">Registrar devolución realizada</button>
            </form>
        </details>
    }
}
else
{
    <form method="post" class="card-custom p-4 mb-4" style="max-width:800px">
        @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" />
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Fecha" class="form-label">Fecha</label><input asp-for="Fecha" type="date" class="form-control" required /></div>
            <div class="col-md-6"><label asp-for="Cuenta" class="form-label">Cuenta</label><select asp-for="Cuenta" asp-items="cuentas" class="form-select" required><option value="">Elegir cuenta</option></select></div>
            <div class="col-md-6"><label asp-for="Tipo" class="form-label">Tipo</label><select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoMovimiento>()" class="form-select"></select></div>
            <div class="col-md-6"><label asp-for="Categoria" class="form-label">Concepto</label><select asp-for="Categoria" asp-items="categorias" class="form-select"></select></div>
            <div class="col-md-6"><label asp-for="Monto" class="form-label">Importe</label><input asp-for="Monto" type="number" step="0.01" min="0.01" class="form-control" required /></div>
            <div class="col-md-6"><label asp-for="IdProveedor" class="form-label">Proveedor (opcional)</label><select asp-for="IdProveedor" asp-items="Model.Proveedores" class="form-select"><option value="">Ninguno</option></select></div>
            <div class="col-12"><label asp-for="Descripcion" class="form-label">Motivo</label><textarea asp-for="Descripcion" class="form-control" required></textarea></div>
            <div class="col-12 form-check ms-2"><input asp-for="DescontarDelReparto" class="form-check-input" /><label asp-for="DescontarDelReparto" class="form-check-label">Descontar este gasto del reparto semanal</label></div>
        </div><button class="btn btn-mv-primary mt-4">Guardar cambios</button>
    </form>
    <button type="button" class="btn btn-outline-danger mb-3" data-bs-toggle="modal" data-bs-target="#deleteModal"
            data-nombre="este movimiento manual" data-delete-url="@Url.Action("Delete", new { id = Model.Id })"
            data-token="@Antiforgery.GetAndStoreTokens(Context).RequestToken">Eliminar movimiento manual</button>
}
<a asp-action="Index" class="btn btn-mv-secondary">Volver a Caja</a>
