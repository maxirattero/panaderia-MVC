@model Panaderia.MVC.Models.ReporteCajaIndexViewModel
@using Panaderia.Models.Enums
@using Panaderia.MVC.Models
@using Panaderia.Services.Implementations
@{ ViewData["Title"] = "Caja"; }
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h1 class="display-6 fw-bold titulo-pagina">Caja</h1><p class="text-muted">Cobros, pagos y dinero disponible.</p></div><div class="d-flex flex-wrap gap-2 align-items-start"><a asp-action="CierreSemanal" class="btn btn-mv-primary">Cierre semanal</a><a asp-action="Historial" class="btn btn-mv-secondary">Historial</a><a asp-action="Configuracion" class="btn btn-mv-secondary">Configuración</a></div></div>
<partial name="_Avisos" />
@if (Model.SaldosConfigurados)
{
    <div class="row g-3 mb-4">@foreach(var s in Model.SaldosCuentas) { <div class="col-sm-4"><div class="card-custom p-4"><div class="text-muted">@CajaUi.Cuenta(s.Cuenta)</div><strong class="fs-3 @(s.Saldo < 0 ? "text-danger" : "")">@CajaUi.Moneda(s.Saldo)</strong></div></div> }</div>
    <p class="text-muted">Total disponible entre cuentas: <strong>@CajaUi.Moneda(Model.SaldosCuentas.Sum(s=>s.Saldo))</strong> · Saldos actuales, independientes del filtro.</p>
}
else
{ <div class="alert alert-info">Para separar el dinero disponible en efectivo, banco y reserva, <a asp-action="Configuracion">configurá los saldos iniciales</a>. El saldo histórico sin conciliación es @CajaUi.Moneda(Model.Saldo).</div> }
<div class="d-flex gap-2 mb-3"><a asp-action="Create" class="btn btn-mv-secondary">Nuevo movimiento</a><a asp-action="Transferencia" class="btn btn-mv-secondary">Transferencia entre cuentas</a></div>
<form method="get" class="card-custom p-3 mb-4"><div class="row g-3 align-items-end">
    <div class="col-sm-6 col-lg-2"><label for="fechaInicio" class="form-label">Desde</label><input id="fechaInicio" name="fechaInicio" type="date" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-sm-6 col-lg-2"><label for="fechaFin" class="form-label">Hasta</label><input id="fechaFin" name="fechaFin" type="date" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-sm-6 col-lg-3"><label asp-for="CuentaFiltro" class="form-label">Cuenta</label><select asp-for="CuentaFiltro" asp-items="Html.GetEnumSelectList<CuentaCaja>()" class="form-select"><option value="">Todas</option></select></div>
    <div class="col-sm-6 col-lg-3"><label asp-for="TipoFiltro" class="form-label">Tipo</label><select asp-for="TipoFiltro" asp-items="Html.GetEnumSelectList<TipoMovimiento>()" class="form-select"><option value="">Todos</option></select></div>
    <div class="col-lg-2"><button class="btn btn-mv-primary">Filtrar</button> <a asp-action="Index">Limpiar</a></div>
</div></form>
<div class="card-custom p-3 mb-4"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Fecha</th><th>Cuenta</th><th>Concepto</th><th class="text-end">Importe</th><th></th></tr></thead><tbody>
@foreach (var m in Model.Movimientos)
{
    <tr><td class="text-nowrap">@CalendarioCaja.Local(m.Fecha).ToString("dd/MM/yyyy")</td><td>@CajaUi.Cuenta(m.Cuenta)</td><td><strong>@m.Categoria</strong><div class="small text-muted">@m.Descripcion</div>@if(m.DescontarDelReparto) { <span class="badge text-bg-warning">Descuenta del reparto</span> }</td><td class="text-end text-nowrap @(m.Tipo == TipoMovimiento.Ingreso ? "text-success" : "text-danger")">@(m.Tipo == TipoMovimiento.Ingreso ? "+" : "−")@CajaUi.Moneda(m.Monto)</td><td><a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-mv-secondary">Ver</a></td></tr>
}
@if (!Model.Movimientos.Any()) { <tr><td colspan="5" class="text-muted text-center py-4">No hay movimientos para este filtro.</td></tr> }
</tbody></table></div>
<p class="small text-muted mb-0">Entradas del período: @CajaUi.Moneda(Model.TotalIngresos) · Salidas: @CajaUi.Moneda(Model.TotalEgresos). Las transferencias internas no suman en estos totales.</p></div>
@if (Model.TotalPaginas > 1)
{
    <nav class="d-flex gap-3 align-items-center" aria-label="Páginas de movimientos">
        @if(Model.Pagina > 1) { <a asp-route-pagina="@(Model.Pagina-1)" asp-route-fechaInicio="@Model.FechaInicio?.ToString("yyyy-MM-dd")" asp-route-fechaFin="@Model.FechaFin?.ToString("yyyy-MM-dd")" asp-route-cuentaFiltro="@Model.CuentaFiltro" asp-route-tipoFiltro="@Model.TipoFiltro">Anterior</a> }
        <span>Página @Model.Pagina de @Model.TotalPaginas</span>
        @if(Model.Pagina < Model.TotalPaginas) { <a asp-route-pagina="@(Model.Pagina+1)" asp-route-fechaInicio="@Model.FechaInicio?.ToString("yyyy-MM-dd")" asp-route-fechaFin="@Model.FechaFin?.ToString("yyyy-MM-dd")" asp-route-cuentaFiltro="@Model.CuentaFiltro" asp-route-tipoFiltro="@Model.TipoFiltro">Siguiente</a> }
    </nav>
}
