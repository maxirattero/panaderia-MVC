@using Panaderia.Models.Entities
@using Panaderia.Models.Enums
@model PedidoViewModel

@{
    ViewData["Title"] = "Editar Pedido";
}

<div style="max-width: 1200px;">
    <div class="mb-4">
        <h1 class="display-6 fw-bold titulo-pagina mb-1">Editar Pedido</h1>
        <p class="text-muted">Modificá los datos del pedido.</p>
    </div>

    <div class="card card-custom p-4 mb-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FechaCreacion" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="IdCliente" class="form-label small fw-bold text-muted">Cliente</label>
                    <select asp-for="IdCliente" class="form-select">
                        <option value="">-- Seleccionar cliente --</option>
                        @foreach (var c in (IEnumerable<Cliente>)ViewBag.Clientes)
                        {
                            <option value="@c.Id"
                                    data-revendedor="@c.Revendedor.ToString().ToLower()"
                                    data-descuento="@((c.DescuentoPorcentaje ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                @c.NombreCompleto
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="FechaEntrega" class="form-label small fw-bold text-muted">Fecha de entrega</label>
                    <input asp-for="FechaEntrega" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="DescuentoPorcentaje" class="form-label small fw-bold text-muted">Descuento (%)</label>
                    <div class="input-group">
                        <input asp-for="DescuentoPorcentaje" type="number" min="0" max="100" step="0.01"
                               class="form-control" placeholder="Sin descuento" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="DescuentoPorcentaje" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notas" class="form-label small fw-bold text-muted">Notas</label>
                    <textarea asp-for="Notas" class="form-control"></textarea>
                </div>
            </div>

            <h4 class="font-literata fw-bold mt-4 mb-3">Productos</h4>
            <table class="table" id="tablaDetalles">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th style="width: 80px;">Cant.</th>
                        <th style="width: 160px;">Empaque</th>
                        <th style="width: 80px;" class="text-center">Etiqueta</th>
                        <th style="width: 100px;">Subtotal</th>
                        <th style="width: 50px;"></th>
                    </tr>
                </thead>
                <tbody id="detallesBody"></tbody>
            </table>

            <button type="button" class="btn btn-mv-primary mb-3" id="btnAgregar">+ Agregar producto</button>

            <div class="d-flex justify-content-end">
                <div class="p-3 rounded-3 bg-light" style="min-width: 280px;">
                    <div class="d-flex justify-content-between">
                        <span class="small text-muted">Subtotal</span>
                        <span id="resumenSubtotal">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mt-1" id="filaDescuento" hidden>
                        <span class="small text-muted">Descuento (<span id="resumenPct">0</span>%)</span>
                        <span id="resumenDescuento" class="text-danger">-$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold border-top mt-2 pt-2">
                        <span>Total</span>
                        <span id="resumenTotal">$0.00</span>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-end gap-3 mt-5 pt-4 border-top">
                <button type="submit" class="btn btn-mv-primary d-flex align-items-center justify-content-center gap-2">
                    <span class="material-symbols-outlined">save</span>Guardar cambios
                </button>
                <a asp-action="Index" class="btn btn-mv-primary">Cancelar</a>
                <button type="button"
                        class="btn btn-outline-danger d-flex align-items-center justify-content-center gap-2"
                        data-bs-toggle="modal" data-bs-target="#anularModal">
                    <span class="material-symbols-outlined">block</span>Anular pedido
                </button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="anularModal" tabindex="-1" aria-labelledby="anularModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="anularModalLabel">&#191;Anular este pedido?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p>&#191;Anular este pedido? Si ten&#237;a cobros registrados, se eliminar&#225; el ingreso correspondiente en Caja. Esta acci&#243;n no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form asp-action="Anular" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined">block</span>Anular pedido
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<template id="filaTemplate">
    <tr>
        <td data-label="Producto">
            <select name="__PROD__" class="form-select prod-select" required>
                <option value="">-- Producto --</option>
                @foreach (var p in (IEnumerable<Producto>)ViewBag.Productos)
                {
                    <option value="@p.Id"
                            data-final="@p.PrecioFinal.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-reventa="@p.PrecioReventa.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        @p.NombreVisible
                    </option>
                }
            </select>
        </td>
        <td data-label="Cantidad">
            <input name="__CANT__" type="number" min="1" placeholder="Cant." class="form-control cant-input" required />
        </td>
        <td data-label="Empaque">
            <select name="__EMPAQUE__" class="form-select empaque-select">
                <option value="">-- Sin empaque --</option>
                @foreach (var e in (IEnumerable<Insumo>)ViewBag.Empaques)
                {
                    <option value="@e.Id">@e.Nombre</option>
                }
            </select>
        </td>
        <td data-label="Etiqueta" class="text-center align-middle">
            <input name="__ETIQUETA__" type="checkbox" class="form-check-input etiqueta-check" value="true" />
        </td>
        <td data-label="Subtotal" class="subtotal">$0</td>
        <td>
            <button type="button" class="btn btn-sm btn-danger btnQuitar">&#x2715;</button>
        </td>
    </tr>
</template>

@section Scripts {
    <script>
        const initialDetalles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Detalles,
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

        (function () {
            const tbody = document.getElementById('detallesBody');
            const template = document.getElementById('filaTemplate');
            const btnAgregar = document.getElementById('btnAgregar');
            const clienteSelect = document.getElementById('IdCliente');
            const descuentoInput = document.getElementById('DescuentoPorcentaje');
            const resumenSubtotal = document.getElementById('resumenSubtotal');
            const resumenDescuento = document.getElementById('resumenDescuento');
            const resumenTotal = document.getElementById('resumenTotal');
            const resumenPct = document.getElementById('resumenPct');
            const filaDescuento = document.getElementById('filaDescuento');

            function clienteEsRevendedor() {
                const opt = clienteSelect.options[clienteSelect.selectedIndex];
                return opt && opt.dataset.revendedor === 'true';
            }

            function precioFila(tr) {
                const prodSelect = tr.querySelector('.prod-select');
                const opt = prodSelect.options[prodSelect.selectedIndex];
                if (!opt || !opt.value) return 0;
                const precio = clienteEsRevendedor()
                    ? parseFloat(opt.dataset.reventa)
                    : parseFloat(opt.dataset.final);
                const cant = parseInt(tr.querySelector('.cant-input').value) || 0;
                return (precio || 0) * cant;
            }

            function recalcularTotales() {
                let bruto = 0;
                tbody.querySelectorAll('tr').forEach(tr => { bruto += precioFila(tr); });

                let pct = parseFloat(descuentoInput.value);
                if (isNaN(pct) || pct < 0) pct = 0;
                if (pct > 100) pct = 100;

                const descuento = bruto * pct / 100;
                const total = bruto - descuento;

                resumenSubtotal.textContent = '$' + bruto.toFixed(2);
                resumenDescuento.textContent = '-$' + descuento.toFixed(2);
                resumenTotal.textContent = '$' + total.toFixed(2);
                resumenPct.textContent = pct.toString();
                filaDescuento.hidden = pct <= 0;
            }

            function recalcularFila(tr) {
                const prodSelect = tr.querySelector('.prod-select');
                const cantInput = tr.querySelector('.cant-input');
                const subtotalCell = tr.querySelector('.subtotal');
                const opt = prodSelect.options[prodSelect.selectedIndex];

                let precio = 0;
                if (opt && opt.value) {
                    precio = clienteEsRevendedor()
                        ? parseFloat(opt.dataset.reventa)
                        : parseFloat(opt.dataset.final);
                }
                const cant = parseInt(cantInput.value) || 0;
                subtotalCell.textContent = '$' + (precio * cant).toFixed(2);
                recalcularTotales();
            }

            function reindexar() {
                tbody.querySelectorAll('tr').forEach((tr, i) => {
                    tr.querySelector('.prod-select').name    = `Detalles[${i}].IdProducto`;
                    tr.querySelector('.cant-input').name     = `Detalles[${i}].Cantidad`;
                    tr.querySelector('.empaque-select').name = `Detalles[${i}].IdEmpaque`;
                    tr.querySelector('.etiqueta-check').name = `Detalles[${i}].LlevaEtiqueta`;
                });
            }

            function agregarFila(data) {
                const tr = template.content.cloneNode(true).querySelector('tr');
                tbody.appendChild(tr);

                if (data) {
                    tr.querySelector('.prod-select').value  = data.idProducto;
                    tr.querySelector('.cant-input').value   = data.cantidad;
                    if (data.idEmpaque) {
                        tr.querySelector('.empaque-select').value = data.idEmpaque;
                    }
                    tr.querySelector('.etiqueta-check').checked = !!data.llevaEtiqueta;
                }

                reindexar();
                recalcularFila(tr);

                tr.querySelector('.prod-select').addEventListener('change', () => recalcularFila(tr));
                tr.querySelector('.cant-input').addEventListener('input', () => recalcularFila(tr));
                tr.querySelector('.btnQuitar').addEventListener('click', () => {
                    tr.remove();
                    reindexar();
                    recalcularTotales();
                });
            }

            btnAgregar.addEventListener('click', () => agregarFila(null));

            // Solo al cambiar de cliente se trae su descuento habitual; el valor guardado del pedido se respeta al abrir.
            function aplicarDescuentoDelCliente() {
                const opt = clienteSelect.options[clienteSelect.selectedIndex];
                const pct = opt ? parseFloat(opt.dataset.descuento) : 0;
                descuentoInput.value = (!isNaN(pct) && pct > 0) ? pct : '';
            }

            clienteSelect.addEventListener('change', () => {
                aplicarDescuentoDelCliente();
                tbody.querySelectorAll('tr').forEach(recalcularFila);
                recalcularTotales();
            });

            descuentoInput.addEventListener('input', recalcularTotales);

            if (initialDetalles.length > 0) {
                initialDetalles.forEach(agregarFila);
            } else {
                agregarFila(null);
            }

            recalcularTotales();
        })();
    </script>
}
