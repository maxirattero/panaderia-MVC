@model Panaderia.MVC.Models.ProduccionViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Planificador de Amasadas";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <h1 class="display-6 fw-bold titulo-pagina mb-1">Planificador de Amasadas</h1>
    <div class="d-flex gap-2">
        <button onclick="resetear()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <span class="material-symbols-outlined">restart_alt</span>Resetear
        </button>
        <button id="imprimirPlanBtn" onclick="solicitarImpresion()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <span class="material-symbols-outlined">print</span>Imprimir plan
        </button>
        <a asp-action="Produccion" class="btn btn-mv-primary">Volver</a>
    </div>
</div>

<div class="mb-3 no-print" style="max-width:900px;">
    <button id="restaurarPlanBtn" type="button" onclick="restaurarPlan(false)" class="btn btn-mv-secondary" hidden>Reabrir último plan guardado</button>
    <a asp-action="PlanificarAmasadas" asp-route-recuperar="true" class="btn btn-link">Reconstruir lo producido esta semana</a>
    <div id="estadoGuardado" class="small mt-2" role="status"></div>
    <div id="avisoReimpresion" class="alert alert-info mt-2" hidden>
        Plan recuperado para organizar y reimprimir. No vuelve a confirmar producción ni a descontar insumos.
        <a asp-action="PlanificarAmasadas" asp-route-nuevo="true">Abrir pendientes actuales</a>
    </div>
    @if (ViewBag.SoloReimpresion == true)
    {
        <div class="alert alert-warning mt-2">Reconstrucción a partir de las cantidades ya producidas de los pedidos de esta semana y las recetas actuales. No incluye producción adicional para stock ni conserva agrupaciones anteriores.</div>
    }
</div>

@if ((int)(ViewBag.CantidadExcluidos ?? 0) > 0)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 no-print" style="max-width:900px;">
        <span class="material-symbols-outlined">visibility_off</span>
        <div>
            Hay <strong>@ViewBag.CantidadExcluidos producto(s) excluidos</strong> desde Producción.
            El plan de abajo no los incluye.
        </div>
    </div>
}

<!-- Action bar for combining — shown when 2+ batches selected -->
<div id="action-bar" class="mb-3 no-print" style="display:none; max-width:900px;">
    <button onclick="combinar()" class="btn btn-mv-primary d-inline-flex align-items-center gap-2">
        <span class="material-symbols-outlined">merge</span>
        Combinar seleccionados (<span id="selected-count">0</span>)
    </button>
</div>

<div id="planificador" style="max-width: 900px;"
     data-solo-reimpresion="@((ViewBag.SoloReimpresion == true).ToString().ToLowerInvariant())"
     data-usuario="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
    <p class="text-muted">Cargando...</p>
</div>

<form id="confirmarPlanificacionForm" asp-action="ConfirmarPlanificacion" method="post">
    @Html.AntiForgeryToken()
    @for (int i = 0; i < Model.ItemsSeleccionables.Count; i++)
    {
        var item = Model.ItemsSeleccionables[i];
        <input type="hidden" name="ItemsSeleccionables[@i].IdProducto" value="@item.IdProducto" />
        <input type="hidden" name="ItemsSeleccionables[@i].IdReceta" value="@item.IdReceta" />
        <input type="hidden" name="ItemsSeleccionables[@i].NombreProducto" value="@item.NombreProducto" />
        <input type="hidden" name="ItemsSeleccionables[@i].CantidadAProducir" value="@item.CantidadAProducir.ToString(CultureInfo.InvariantCulture)" />
        <input type="hidden" name="ItemsSeleccionables[@i].EsStock" value="@item.EsStock.ToString().ToLowerInvariant()" />
        <input type="hidden" name="ItemsSeleccionables[@i].IdProduccionStock" value="@item.IdProduccionStock" />
        <input type="hidden" name="ItemsSeleccionables[@i].Revision" value="@item.Revision" />
        <input type="hidden" name="ItemsSeleccionables[@i].Seleccionado" value="true" />
    }
</form>

<div id="produccionConfirmada" class="alert alert-success no-print" style="display:none;" role="status">
    Producción confirmada. Los productos se retiraron de los pendientes y los insumos se descontaron una sola vez.
    Podés volver a imprimir este plan sin descontar insumos nuevamente.
</div>
<div class="modal fade no-print" id="confirmarImpresionModal" tabindex="-1" aria-labelledby="confirmarImpresionTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="confirmarImpresionTitulo">¿Confirmar la producción de este plan?</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
            <p>Se confirmarán únicamente los productos de este plan seleccionados en Producción. Se descontarán sus insumos y dejarán de aparecer como pendientes.</p>
            <p class="mb-0">Si solo querés revisar o imprimir el plan, elegí «Solo imprimir».</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-mv-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="button" class="btn btn-mv-secondary" onclick="soloImprimir()">Solo imprimir</button>
            <button type="button" class="btn btn-mv-primary" onclick="confirmarEImprimir()">Confirmar e imprimir</button>
        </div>
    </div></div>
</div>

<!-- Hidden container for print layout -->
<div id="print-area" style="display:none;"></div>

<style>
    @@media print {
        .no-print, .modal, .modal-backdrop, .offcanvas, .offcanvas-backdrop, .sidebar, .top-app-bar { display: none !important; }
        html, body { background: white !important; overflow: visible !important; }
        body { padding: 0 !important; }
        .main-content { margin: 0 !important; padding: 0 !important; }
        .main-content > .container-fluid { padding: 0 !important; }
        #planificador { display: none !important; }
        #print-area {
            display: block !important;
            font-size: 13px;
            font-family: Arial, sans-serif;
        }
        #print-area, #print-area * {
            color: #000 !important;
            -webkit-text-fill-color: #000 !important;
            opacity: 1 !important;
            text-shadow: none !important;
            border-color: #000 !important;
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }
        #print-area .grid-amasadas {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        #print-area .amasada-card {
            border: 1px solid #ccc;
            padding: 10px;
            border-radius: 4px;
            font-size: 12px;
            break-inside: avoid;
        }
        #print-area .amasada-card:nth-child(4n) {
            break-after: page;
        }
    }
</style>

@section Scripts {
<script>
    // ─── Data & State ───────────────────────────────────
    let productosOriginales = @Html.Raw(ViewBag.ProductosJson);
    let subRecetasOriginales = @Html.Raw(ViewBag.SubRecetasJson);
    const anteriores = new Map((new URLSearchParams(location.search).get('anteriores') || '')
        .split(',').map(par => par.split(':').map(Number))
        .filter(([id, cantidad]) => Number.isInteger(id) && id > 0 && Number.isFinite(cantidad) && cantidad > 0));
    let amasadas = [];
    let nextId = 1;
    const configuracion = document.getElementById('planificador').dataset;
    const claveGuardado = 'masa-viva:plan-amasadas:v1:' + configuracion.usuario;
    const fuenteActual = JSON.stringify([productosOriginales, subRecetasOriginales, [...anteriores],
        Array.from(document.querySelectorAll('#confirmarPlanificacionForm input[name$=".Revision"]'), input => input.value)]);
    let soloReimpresion = configuracion.soloReimpresion === 'true';
    let fechaPlan = new Date().toISOString();

    function leerPlan() {
        try {
            const plan = JSON.parse(localStorage.getItem(claveGuardado));
            if (plan?.version !== 1 || !Array.isArray(plan.amasadas) || !plan.amasadas.length
                || !Array.isArray(plan.productos) || !Array.isArray(plan.subRecetas)
                || !Array.isArray(plan.anteriores) || !Number.isInteger(plan.nextId)
                || !Number.isFinite(Date.parse(plan.fecha))) return null;
            const productoValido = p => p && Number.isFinite(p.pesoMasaTotal) && Number.isFinite(p.cantidadUnidades)
                && Array.isArray(p.ingredientes) && p.ingredientes.every(i => i && Number.isFinite(i.gramos));
            if (!plan.productos.every(productoValido) || !plan.amasadas.every(a => Number.isInteger(a.id)
                && Array.isArray(a.productos) && a.productos.length && a.productos.every(productoValido)
                && (!a.splitInfo || (Number.isInteger(a.splitInfo.parte) && Number.isInteger(a.splitInfo.total))))) return null;
            return plan;
        } catch { return null; }
    }

    function guardarPlan(forzarReimpresion = false) {
        if (!amasadas.length) return;
        try {
            localStorage.setItem(claveGuardado, JSON.stringify({ version: 1, fuente: fuenteActual,
                productos: productosOriginales, subRecetas: subRecetasOriginales, anteriores: [...anteriores],
                amasadas, nextId, fecha: fechaPlan, soloReimpresion: forzarReimpresion || soloReimpresion || produccionConfirmada || intentoConfirmacion }));
            document.getElementById('estadoGuardado').textContent = 'Plan guardado en este navegador, con sus combinaciones y divisiones.';
            document.getElementById('restaurarPlanBtn').hidden = false;
        } catch {
            document.getElementById('estadoGuardado').textContent = 'No se pudo guardar el plan en este navegador. Conservá esta pestaña abierta o guardá la impresión como PDF.';
        }
    }

    function restaurarPlan(permitirConfirmacion) {
        const plan = leerPlan();
        if (!plan) return false;
        soloReimpresion = !permitirConfirmacion || plan.soloReimpresion || plan.fuente !== fuenteActual;
        productosOriginales = plan.productos;
        subRecetasOriginales = plan.subRecetas;
        anteriores.clear();
        plan.anteriores.forEach(([id, cantidad]) => anteriores.set(id, cantidad));
        amasadas = plan.amasadas;
        nextId = plan.nextId;
        fechaPlan = plan.fecha;
        document.getElementById('avisoReimpresion').hidden = !soloReimpresion;
        document.getElementById('estadoGuardado').textContent = 'Plan recuperado del ' + new Date(fechaPlan).toLocaleString('es-AR') + '.';
        render();
        return true;
    }

    function escaparHtml(texto) {
        const div = document.createElement('div');
        div.textContent = texto || '';
        return div.innerHTML.replace(/\n/g, '<br>');
    }

    // ─── Init ───────────────────────────────────────────
    function init() {
        const guardado = leerPlan();
        document.getElementById('restaurarPlanBtn').hidden = !guardado;
        const query = new URLSearchParams(location.search);
        if (!query.has('nuevo') && guardado
            && ((!soloReimpresion && !productosOriginales.length) || guardado.fuente === fuenteActual)
            && restaurarPlan(!soloReimpresion)) return;
        document.getElementById('avisoReimpresion').hidden = !soloReimpresion;
        crearAmasadas();
        if (!guardado || soloReimpresion) guardarPlan();
    }

    function crearAmasadas() {
        nextId = 1;
        amasadas = productosOriginales.map(p => ({
            id: nextId++,
            productos: [structuredClone(p)],
            splitInfo: null   // { parte: 1, total: 3 } when split
        }));
        render();
    }

    // ─── Combine ────────────────────────────────────────
    function combinar() {
        const checks = document.querySelectorAll('.batch-check:checked');
        const ids = Array.from(checks).map(c => parseInt(c.dataset.id));
        if (ids.length < 2) return;

        const nuevaAmasada = { id: nextId++, productos: [], splitInfo: null };
        for (const id of ids) {
            const batch = amasadas.find(a => a.id === id);
            if (batch) nuevaAmasada.productos.push(...batch.productos);
        }
        amasadas = amasadas.filter(a => !ids.includes(a.id));
        amasadas.push(nuevaAmasada);
        render();
        guardarPlan();
    }

    // ─── Uncombine ──────────────────────────────────────
    function desCombinar(amasadaId) {
        const batch = amasadas.find(a => a.id === amasadaId);
        if (!batch || batch.productos.length < 2) return;

        const idx = amasadas.indexOf(batch);
        amasadas.splice(idx, 1);
        for (let i = 0; i < batch.productos.length; i++) {
            amasadas.splice(idx + i, 0, {
                id: nextId++,
                productos: [batch.productos[i]],
                splitInfo: null
            });
        }
        render();
        guardarPlan();
    }

    // ─── Split ──────────────────────────────────────────
    function dividir(amasadaId) {
        const input = document.getElementById('div-' + amasadaId);
        const n = parseInt(input?.value);
        if (!n || n < 2 || n > 10) return;

        const batch = amasadas.find(a => a.id === amasadaId);
        if (!batch || batch.productos.length !== 1) return;

        const prod = batch.productos[0];
        const idx = amasadas.indexOf(batch);
        amasadas.splice(idx, 1);

        for (let i = 0; i < n; i++) {
            amasadas.splice(idx + i, 0, {
                id: nextId++,
                productos: [{
                    ...structuredClone(prod),
                    pesoMasaTotal: prod.pesoMasaTotal / n,
                    cantidadUnidades: prod.cantidadUnidades / n,
                    ingredientes: prod.ingredientes.map(ing => ({
                        ...ing,
                        gramos: ing.gramos / n
                    }))
                }],
                splitInfo: { parte: i + 1, total: n }
            });
        }
        render();
        guardarPlan();
    }

    // ─── Reset ──────────────────────────────────────────
    function resetear() {
        crearAmasadas();
        guardarPlan();
    }

    // ─── Combine ingredients across products ────────────
    function getIngredientesCombinados(amasada) {
        const map = new Map();
        for (const prod of amasada.productos) {
            for (const ing of prod.ingredientes) {
                const key = ing.esSubReceta
                    ? 'sr-' + ing.idSubReceta
                    : 'in-' + ing.idInsumo;
                if (map.has(key)) {
                    map.get(key).gramos += ing.gramos;
                } else {
                    map.set(key, { ...ing });
                }
            }
        }
        return Array.from(map.values());
    }

    // ─── Pesos agrupados por masa ───────────────────────
    function getPesosPorMasa(amasada) {
        const map = new Map();
        for (const p of amasada.productos) {
            if (map.has(p.masaKey)) {
                map.get(p.masaKey).pesoTotal += p.pesoMasaTotal;
            } else {
                map.set(p.masaKey, { nombreMasa: p.nombreMasa, nombreCategoria: p.nombreCategoria, pesoTotal: p.pesoMasaTotal });
            }
        }
        return Array.from(map.values());
    }

    // ─── Update action bar visibility ───────────────────
    function updateActionBar() {
        const checked = document.querySelectorAll('.batch-check:checked').length;
        document.getElementById('action-bar').style.display = checked >= 2 ? '' : 'none';
        document.getElementById('selected-count').textContent = checked;
    }

    // ─── Render ─────────────────────────────────────────
    function render() {
        const container = document.getElementById('planificador');

        if (!amasadas.length) {
            container.innerHTML = soloReimpresion
                ? '<p class="text-muted">No hay cantidades producidas con receta para reconstruir esta semana.</p>'
                : '<p class="text-muted">No hay productos con receta en los pedidos pendientes.</p>';
            document.getElementById('action-bar').style.display = 'none';
            return;
        }

        let html = '<div class="row g-4">';

        amasadas.forEach((am, idx) => {
            const esCombinada = am.productos.length > 1;
            const pesoTotal = am.productos.reduce((s, p) => s + p.pesoMasaTotal, 0);
            const ingredientes = getIngredientesCombinados(am);

            // Card title
            let titulo = 'Amasada ' + (idx + 1);
            if (am.splitInfo) {
                titulo += ' <span class="text-muted small">(' + am.splitInfo.parte + '/' + am.splitInfo.total + ')</span>';
            }

            html += `
            <div class="col-md-6">
                <div class="card card-custom p-4">
                    <div class="d-flex align-items-start gap-2 mb-2">
                        <input type="checkbox" class="form-check-input mt-1 batch-check no-print"
                               data-id="${am.id}" onchange="updateActionBar()">
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-0">${titulo}</h5>
                        </div>
                        ${esCombinada
                            ? `<button onclick="desCombinar(${am.id})"
                                    class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 no-print">
                                    <span class="material-symbols-outlined" style="font-size:16px;">undo</span>Deshacer
                               </button>`
                            : `<div class="d-inline-flex align-items-center gap-1 no-print">
                                    <input type="number" id="div-${am.id}" value="2" min="2" max="10"
                                           class="form-control form-control-sm" style="width:60px;">
                                    <button onclick="dividir(${am.id})"
                                            class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                                        <span class="material-symbols-outlined" style="font-size:16px;">content_cut</span>Dividir
                                    </button>
                               </div>`
                        }
                    </div>

                    <!-- Pesos agrupados por masa -->
                    ${getPesosPorMasa(am).map(g => `
                        <div class="d-flex justify-content-between small mb-1">
                            <span>${g.nombreCategoria ? escaparHtml(g.nombreCategoria) + ' — ' : ''}${escaparHtml(g.nombreMasa)}</span>
                            <strong>${Math.round(g.pesoTotal)} g</strong>
                        </div>
                    `).join('')}
                    ${getPesosPorMasa(am).length > 1 ? `
                        <div class="d-flex justify-content-between small fw-bold border-top pt-1 mb-2">
                            <span>TOTAL</span>
                            <span>${Math.round(pesoTotal)} g</span>
                        </div>` : '<div class="mb-2"></div>'
                    }
                    ${am.productos.filter(p => p.observacionesElaboracion).map(p => `
                        <div class="small mb-2 p-2" style="border-left:3px solid #855330; background:#f5efe9;">
                            <strong>${escaparHtml(p.nombreProducto)} — notas de elaboración</strong><br>
                            ${escaparHtml(p.observacionesElaboracion)}
                        </div>`).join('')}

                    <!-- Ingredient table -->
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Ingrediente</th>
                                <th class="text-end">Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${ingredientes.map(ing => `
                            <tr${ing.esSubReceta ? ' class="table-warning"' : ''}>
                                <td>${ing.esSubReceta ? '\u27F3 ' : ''}${escaparHtml(ing.nombre)}</td>
                                <td class="text-end fw-bold">${Math.round(ing.gramos)} ${escaparHtml(ing.unidad)}</td>
                            </tr>`).join('')}
                        </tbody>
                    </table>
                </div>
            </div>`;
        });

        html += '</div>';
        container.innerHTML = html;

        // Reset action bar
        document.getElementById('action-bar').style.display = 'none';
    }

    // ─── Print ──────────────────────────────────────────
    let confirmandoProduccion = false;
    let produccionConfirmada = false;
    let intentoConfirmacion = false;
    function solicitarImpresion() {
        if (confirmandoProduccion) return;
        if (soloReimpresion || produccionConfirmada || !productosOriginales.length) {
            imprimirSinConfirmar();
            return;
        }
        bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmarImpresionModal')).show();
    }

    function soloImprimir() {
        if (confirmandoProduccion) return;
        imprimirSinConfirmar();
    }

    async function confirmarEImprimir() {
        if (confirmandoProduccion) return;
        if (soloReimpresion || produccionConfirmada) { imprimirSinConfirmar(); return; }
        confirmandoProduccion = true;
        const buttons = document.querySelectorAll('#confirmarImpresionModal button, #imprimirPlanBtn');
        buttons.forEach(button => button.disabled = true);
        try {
            // Ante una respuesta perdida, la copia guardada solo permite reimprimir.
            intentoConfirmacion = true;
            guardarPlan(true);
            const form = document.getElementById('confirmarPlanificacionForm');
            const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
            if (!response.ok || response.redirected) throw new Error('No se pudo confirmar la producción. Recargá Producción para comprobar el estado antes de reintentar.');
            const resultado = await response.json();
            if (!resultado.success) throw new Error(resultado.error || 'No se pudo confirmar la producción.');
            produccionConfirmada = true;
            document.getElementById('produccionConfirmada').style.display = '';
            imprimirSinConfirmar();
        } catch (error) {
            alert(error.message || 'No se pudo comprobar la confirmación. Volvé a Producción para revisar el estado.');
        } finally {
            confirmandoProduccion = false;
            buttons.forEach(button => button.disabled = false);
        }
    }

    function imprimirSinConfirmar() {
        guardarPlan();
        const printArea = document.getElementById('print-area');
        const hoy = new Date(fechaPlan).toLocaleDateString('es-AR');

        let html = `<h4>Plan de amasadas \u2014 ${hoy}</h4>`;
        html += '<div class="grid-amasadas">';

        amasadas.forEach((am, idx) => {
            const esCombinada = am.productos.length > 1;
            const pesoTotal = am.productos.reduce((s, p) => s + p.pesoMasaTotal, 0);
            const ingredientes = getIngredientesCombinados(am);

            let titulo = 'Amasada ' + (idx + 1);
            if (am.splitInfo) titulo += ' (' + am.splitInfo.parte + '/' + am.splitInfo.total + ')';

            html += `<div class="amasada-card">`;
            html += `<h5 style="margin:0 0 4px 0; font-size:14px;">${titulo}</h5>`;

            // Pesos agrupados por masa
            const pesosPorMasa = getPesosPorMasa(am);
            for (const g of pesosPorMasa) {
                html += `<div style="display:flex; justify-content:space-between; font-size:11px; margin-bottom:2px;">
                    <span>${g.nombreCategoria ? escaparHtml(g.nombreCategoria) + ' — ' : ''}${escaparHtml(g.nombreMasa)}</span>
                    <strong>${Math.round(g.pesoTotal)} g</strong>
                </div>`;
            }
            if (pesosPorMasa.length > 1) {
                html += `<div style="display:flex; justify-content:space-between; font-size:11px; font-weight:bold; border-top:1px solid #ccc; padding-top:2px; margin-bottom:4px;">
                    <span>TOTAL</span>
                    <span>${Math.round(pesoTotal)} g</span>
                </div>`;
            } else {
                html += '<div style="margin-bottom:4px;"></div>';
            }

            // Ingredient table
            html += `<table style="width:100%; border-collapse:collapse; font-size:11px;">
                <thead>
                    <tr>
                        <th style="border:1px solid #ccc; padding:3px 6px; background:#f0f0f0; text-align:left;">Ingrediente</th>
                        <th style="border:1px solid #ccc; padding:3px 6px; background:#f0f0f0; text-align:center;">Unidad</th>
                        <th style="border:1px solid #ccc; padding:3px 6px; background:#f0f0f0; text-align:right;">Cantidad</th>
                    </tr>
                </thead>
                <tbody>`;

            for (const ing of ingredientes) {
                const bg = ing.esSubReceta ? ' background-color:#fff8e1;' : '';
                const prefix = ing.esSubReceta ? '\u27F3 ' : '';
                html += `<tr>
                    <td style="border:1px solid #ccc; padding:3px 6px;${bg}">${prefix}${escaparHtml(ing.nombre)}</td>
                    <td style="border:1px solid #ccc; padding:3px 6px; text-align:center;${bg}">${escaparHtml(ing.unidad)}</td>
                    <td style="border:1px solid #ccc; padding:3px 6px; text-align:right;${bg}">${Math.round(ing.gramos)}</td>
                </tr>`;
            }

            html += '</tbody></table>';
            html += `<p style="margin:6px 0 0 0; font-size:11px;">
                <strong>Peso masa total:</strong> ${Math.round(pesoTotal)} g
            </p>`;
            html += '</div>';
        });

        html += '</div>';

        // Preparaciones previas
        if (subRecetasOriginales && subRecetasOriginales.length > 0) {
            html += `<div style="margin-top: 20px;">
                <h4 style="margin-bottom: 10px; font-size: 14px; border-bottom: 1px solid #ccc; padding-bottom: 4px;">
                    Preparaciones previas
                </h4>
                <div class="grid-amasadas">`;

            for (const sr of subRecetasOriginales) {
                const anterior = anteriores.get(sr.idSubReceta) || 0;
                const restante = Math.max(0, sr.totalGramos - anterior);
                const factor = sr.totalGramos > 0 ? restante / sr.totalGramos : 0;
                html += `<div class="amasada-card">
                    <h5 style="margin:0 0 4px 0; font-size:14px;">${escaparHtml(sr.nombre)}</h5>
                    <p style="margin:0 0 6px 0; font-size:11px; color:#555;">
                        Total con margen: <strong>${Math.round(sr.totalGramos)} g</strong>
                        ${anterior > 0 ? `<br>Ya preparado: <strong>${anterior} g</strong><br>A preparar: <strong>${Math.round(restante)} g</strong>` : ''}
                    </p>
                    <table style="width:100%; border-collapse:collapse; font-size:11px;">
                        <thead>
                            <tr>
                                <th style="border:1px solid #ccc; padding:3px 6px; background:#f0f0f0; text-align:left;">Ingrediente</th>
                                <th style="border:1px solid #ccc; padding:3px 6px; background:#f0f0f0; text-align:right;">Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>`;

                for (const ing of sr.ingredientes) {
                    html += `<tr>
                        <td style="border:1px solid #ccc; padding:3px 6px;">${escaparHtml(ing.nombreInsumo)}</td>
                        <td style="border:1px solid #ccc; padding:3px 6px; text-align:right;">${Math.round(ing.cantidad * factor * 10) / 10} ${escaparHtml(ing.unidad)}</td>
                    </tr>`;
                }

                html += `</tbody></table></div>`;
            }

            html += '</div></div>';
        }

        printArea.innerHTML = html;

        const modal = document.getElementById('confirmarImpresionModal');
        if (modal.classList.contains('show')) {
            modal.addEventListener('hidden.bs.modal', () => window.print(), { once: true });
            bootstrap.Modal.getOrCreateInstance(modal).hide();
        } else {
            setTimeout(() => window.print(), 100);
        }
    }

    // ─── Boot ───────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', init);
</script>
}
