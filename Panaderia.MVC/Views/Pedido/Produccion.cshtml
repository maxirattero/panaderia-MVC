@using Panaderia.Models.DTOs
@model Panaderia.MVC.Models.ProduccionViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Producción";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6 fw-bold titulo-pagina mb-1">Dashboard de Producción</h1>
    <div class="d-flex gap-2">
        <a asp-action="PlanificarAmasadas"
           class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <span class="material-symbols-outlined">blender</span>Planificar amasadas
        </a>
        <a asp-action="ImprimirProduccion" target="_blank" onclick="return imprimirPlan(event)"
           class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <span class="material-symbols-outlined">print</span>Imprimir plan
        </a>
        <a asp-action="Index" class="btn btn-mv-primary">Volver</a>
    </div>
</div>

<div style="max-width: 900px;">
    @if (ViewBag.HayExcluidos == true)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
            <span class="material-symbols-outlined">visibility_off</span>
            <div class="flex-grow-1">
                Hay <strong>@ViewBag.CantidadExcluidos producto(s) excluidos</strong> de los cálculos.
                Los totales, las sub-recetas, el agua, el planificador y la impresión no los incluyen.
            </div>
            <form asp-action="MostrarTodosProduccion" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap">Incluir todos</button>
            </form>
        </div>
    }

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card card-custom p-4">
                <h5 class="fw-bold mb-3">Totales por Producto</h5>
                @if (!Model.PorProducto.Any())
                {
                    <p class="text-muted">No hay pedidos pendientes de producción.</p>
                }
                else
                {
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th class="text-end">Cantidad a producir</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PorProducto)
                            {
                                <tr>
                                    <td>@item.NombreProducto</td>
                                    <td class="text-end fw-bold">@item.CantidadTotal</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="col-md-6">
            <div class="card card-custom p-4">
                <h5 class="fw-bold mb-3">Totales por Tipo de Bolsa</h5>
                @if (!Model.PorBolsa.Any())
                {
                    <p class="text-muted">No hay pedidos pendientes de producción.</p>
                }
                else
                {
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Tipo de bolsa</th>
                                <th class="text-end">Cantidad total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PorBolsa)
                            {
                                <tr>
                                    <td>@item.Bolsa</td>
                                    <td class="text-end fw-bold">@item.CantidadTotal</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    @if (Model.PorSubReceta.Any() || Model.TotalAgua > 0)
    {
        <div class="row g-4 mt-0">
            @if (Model.TotalAgua > 0)
            {
                <div class="col-md-6">
                    <div class="card card-custom p-4">
                        <h5 class="fw-bold mb-1">
                            <span class="material-symbols-outlined align-middle me-1">water_drop</span>Agua
                        </h5>
                        <p class="mb-0 mt-2">
                            Total necesario:
                            <strong class="fs-4">@Model.TotalAgua.ToString("N0") g</strong>
                        </p>
                    </div>
                </div>
            }
            @foreach (var sr in Model.PorSubReceta)
            {
                var esMasaMadre = sr.Nombre != null && sr.Nombre.ToLowerInvariant().Contains("masa madre");
                var etiquetaAnterior = esMasaMadre ? "Masa madre anterior (g)" : "Ya tengo preparado (g)";
                <div class="col-md-6">
                    <div class="card card-custom p-4 sr-card" data-sr="@sr.IdSubReceta" data-total="@sr.TotalGramos.ToString(CultureInfo.InvariantCulture)">
                        <h5 class="fw-bold mb-1">@sr.Nombre</h5>
                        <p class="text-muted small mb-2">
                            Total con margen: <strong>@sr.TotalGramos.ToString("0.#") g</strong>
                        </p>

                        <div class="mb-2">
                            <label class="form-label small mb-1">@etiquetaAnterior</label>
                            <input type="number" class="form-control form-control-sm sr-anterior"
                                   style="width:130px;" min="0" step="1" value="0" lang="en"
                                   oninput="recalcSubReceta(this)" />
                        </div>
                        <p class="small mb-2 sr-restante" style="display:none;">
                            Restante a preparar: <strong class="sr-restante-val"></strong>
                        </p>

                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Ingrediente</th>
                                    <th class="text-end">Cantidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ing in sr.Ingredientes)
                                {
                                    <tr>
                                        <td>@ing.NombreInsumo</td>
                                        <td class="text-end fw-bold sr-ing"
                                            data-base="@ing.Cantidad.ToString(CultureInfo.InvariantCulture)"
                                            data-unidad="@ing.Unidad">
                                            @ing.Cantidad.ToString("0.#") @ing.Unidad
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-4" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        var msgs = TempData["Warning"]!.ToString()!.Split('|');
        <div class="alert alert-warning alert-dismissible fade show mt-4" role="alert">
            @foreach (var msg in msgs)
            {
                <div>@msg</div>
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-4" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card card-custom p-4 mt-4">
        <h5 class="fw-semibold mb-1">Confirmar producción</h5>
        <p class="text-muted small mb-3">
            Destildá lo que no vayas a hacer y tocá <strong>Actualizar cálculos</strong>: se recalculan los
            totales, las sub-recetas y el agua, y queda igual en el planificador y la impresión.
        </p>

        <div class="border rounded p-3 mb-3" style="background-color: var(--mv-background);">
            <label class="form-label fw-semibold mb-2">Producir para stock (sin pedido)</label>
            <form asp-action="AgregarProduccionStock" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex flex-wrap align-items-end gap-2">
                    <div>
                        <select name="idProducto" class="form-select form-select-sm" style="min-width:240px;" required>
                            <option value="">Seleccionar producto...</option>
                            @foreach (var p in Model.ProductosDisponibles)
                            {
                                <option value="@p.IdProducto">@p.NombreProducto</option>
                            }
                        </select>
                    </div>
                    <div>
                        <input type="number" name="cantidad" class="form-control form-control-sm"
                               style="width:90px;" lang="en" step="1" min="1" value="1" required />
                    </div>
                    <button type="submit" class="btn btn-mv-secondary btn-sm d-inline-flex align-items-center gap-1">
                        <span class="material-symbols-outlined" style="font-size:18px;">add</span>Agregar
                    </button>
                </div>
            </form>
            @if (!Model.ProductosDisponibles.Any())
            {
                <p class="text-muted small mb-0 mt-2">No hay productos con receta cargada.</p>
            }
        </div>

        <form asp-action="ConfirmarProduccion" method="post">
            @Html.AntiForgeryToken()
            <div class="table-responsive mb-3">
                <table class="table table-sm align-middle mb-0">
                    <thead style="background-color: #cebaac; color: #281714;">
                        <tr>
                            <th style="width:40px;"></th>
                            <th>Producto</th>
                            <th style="width:220px;">Cantidad a producir</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.ItemsSeleccionables.Count; i++)
                        {
                            var item = Model.ItemsSeleccionables[i];
                            <tr class="@(item.Seleccionado ? "" : "fila-excluida")">
                                <td>
                                    <input type="hidden" name="ItemsSeleccionables[@i].IdProducto" value="@item.IdProducto" />
                                    <input type="hidden" name="ItemsSeleccionables[@i].IdReceta" value="@item.IdReceta" />
                                    <input type="hidden" name="ItemsSeleccionables[@i].NombreProducto" value="@item.NombreProducto" />
                                    <input type="hidden" name="ItemsSeleccionables[@i].CantidadSugerida"
                                           value="@item.CantidadSugerida.ToString(CultureInfo.InvariantCulture)" />
                                    <input type="hidden" name="ItemsSeleccionables[@i].EsStock" value="@item.EsStock.ToString().ToLower()" />
                                    <input type="hidden" name="ItemsSeleccionables[@i].IdProduccionStock" value="@item.IdProduccionStock" />
                                    <input type="checkbox" name="ItemsSeleccionables[@i].Seleccionado" value="true"
                                           class="form-check-input" @(item.Seleccionado ? "checked" : "") />
                                    <input type="hidden" name="ItemsSeleccionables[@i].Seleccionado" value="false" />
                                </td>
                                <td>
                                    @item.NombreProducto
                                    @if (item.EsStock)
                                    {
                                        <span class="badge rounded-pill ms-1"
                                              style="background-color:#855330; font-size:11px;">stock</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <input type="number"
                                               name="ItemsSeleccionables[@i].CantidadAProducir"
                                               class="form-control form-control-sm"
                                               style="width:90px"
                                               lang="en" step="1" min="1"
                                               value="@item.CantidadAProducir.ToString(CultureInfo.InvariantCulture)" />
                                        @if (item.EsStock)
                                        {
                                            <button type="submit" name="id" value="@item.IdProduccionStock"
                                                    formaction="@Url.Action("QuitarProduccionStock", "Pedido")"
                                                    formmethod="post"
                                                    class="btn btn-sm btn-outline-danger d-inline-flex align-items-center"
                                                    title="Quitar de stock">
                                                <span class="material-symbols-outlined" style="font-size:16px;">close</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.ItemsSeleccionables.Any())
            {
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" formaction="@Url.Action("AplicarSeleccionProduccion", "Pedido")"
                            class="btn btn-mv-secondary d-inline-flex align-items-center gap-2">
                        <span class="material-symbols-outlined">calculate</span>Actualizar cálculos
                    </button>
                    <button type="submit" class="btn btn-mv-primary d-inline-flex align-items-center gap-2">
                        <span class="material-symbols-outlined">check_circle</span>Confirmar producción
                    </button>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No hay nada para producir. Agregá productos para stock arriba, o cargá pedidos.</p>
            }
        </form>
    </div>
</div>

<style>
    /* Fila de un producto excluido de los cálculos */
    .fila-excluida td {
        opacity: 0.5;
        text-decoration: line-through;
    }

    .fila-excluida td:first-child,
    .fila-excluida td:last-child {
        text-decoration: none;
    }
</style>

@section Scripts {
    <script>
        // Marca visualmente la fila al tildar/destildar, antes de recargar
        document.querySelectorAll('input[type="checkbox"][name$=".Seleccionado"]').forEach(function (chk) {
            chk.addEventListener('change', function () {
                const fila = chk.closest('tr');
                if (fila) fila.classList.toggle('fila-excluida', !chk.checked);
            });
        });

        function imprimirPlan(e) {
            const params = [];
            document.querySelectorAll('.sr-card').forEach(card => {
                const idSub = card.dataset.sr;
                const input = card.querySelector('.sr-anterior');
                const ant = input ? parseFloat(input.value) : 0;
                if (idSub && !isNaN(ant) && ant > 0) {
                    params.push(idSub + ':' + ant);
                }
            });

            if (params.length) {
                e.preventDefault();
                const base = '@Url.Action("ImprimirProduccion", "Pedido")';
                const url = base + '?anteriores=' + encodeURIComponent(params.join(','));
                window.open(url, '_blank');
                return false;
            }
            return true;
        }

        function recalcSubReceta(input) {
            const card = input.closest('.sr-card');
            if (!card) return;

            const total = parseFloat(card.dataset.total) || 0;
            let anterior = parseFloat(input.value);
            if (isNaN(anterior) || anterior < 0) anterior = 0;

            const restante = Math.max(0, total - anterior);
            const factor = total > 0 ? restante / total : 0;

            card.querySelectorAll('.sr-ing').forEach(td => {
                const base = parseFloat(td.dataset.base) || 0;
                const unidad = td.dataset.unidad || '';
                const val = Math.round(base * factor * 10) / 10;
                td.textContent = val + ' ' + unidad;
            });

            const restanteRow = card.querySelector('.sr-restante');
            const restanteVal = card.querySelector('.sr-restante-val');
            if (anterior > 0) {
                restanteVal.textContent = (Math.round(restante * 10) / 10) + ' g';
                restanteRow.style.display = '';
            } else {
                restanteRow.style.display = 'none';
            }
        }
    </script>
}
