@model TiendaIndexViewModel
@{
    Layout = "_TiendaLayout";
    ViewData["Title"] = "Tienda";
    var ar = new System.Globalization.CultureInfo("es-AR");
}

@if (TempData["TiendaMsg"] != null)
{
    <div class="tienda-toast">
        <span class="material-symbols-outlined">check_circle</span> @TempData["TiendaMsg"]
    </div>
}

<!-- Hero -->
<section class="tienda-hero con-foto">
    <p class="tienda-hero-destacado">Panificados artesanales de masa madre y fermentación lenta.</p>
    <p>Materia prima de calidad, sin aditivos ni conservantes.</p>
    <p class="tienda-hero-entrega">Armá tu pedido en la tienda y recibilo en tu casa el sábado sin costo. 🚚</p>
</section>

<aside class="tienda-aviso-pedidos" role="note">
    <span class="material-symbols-outlined">schedule</span>
    <span>Tomamos pedidos de panes hasta los jueves a las 24 hs.</span>
</aside>

<!-- Buscador -->
<form method="get" asp-controller="Tienda" asp-action="Index" class="tienda-search">
    <span class="material-symbols-outlined">search</span>
    <input type="text" name="q" value="@Model.Busqueda" class="search-input" placeholder="Buscar pan, crackers, untables..." />
    @if (!string.IsNullOrEmpty(Model.CategoriaSeleccionada))
    {
        <input type="hidden" name="categoria" value="@Model.CategoriaSeleccionada" />
    }
    @if (Model.EtiquetaSeleccionada.HasValue)
    {
        <input type="hidden" name="etiqueta" value="@Model.EtiquetaSeleccionada" />
    }
</form>

<!-- Categorías -->
<div class="tienda-chips">
    <a class="pill-filtro @(string.IsNullOrEmpty(Model.CategoriaSeleccionada) ? "activo" : "")"
       asp-controller="Tienda" asp-action="Index" asp-route-q="@Model.Busqueda" asp-route-etiqueta="@Model.EtiquetaSeleccionada">Todos</a>
    @foreach (var cat in Model.Categorias)
    {
        <a class="pill-filtro @(string.Equals(cat, Model.CategoriaSeleccionada, StringComparison.OrdinalIgnoreCase) ? "activo" : "")"
           asp-controller="Tienda" asp-action="Index" asp-route-categoria="@cat" asp-route-q="@Model.Busqueda" asp-route-etiqueta="@Model.EtiquetaSeleccionada">@cat</a>
    }
</div>

<!-- Etiquetas -->
@if (Model.Etiquetas.Any())
{
    <div class="tienda-chips etiquetas">
        @foreach (var et in Model.Etiquetas)
        {
            var activa = Model.EtiquetaSeleccionada == et.Id;
            <a class="pill-filtro etiqueta @(activa ? "activo" : "")"
               asp-controller="Tienda" asp-action="Index"
               asp-route-categoria="@Model.CategoriaSeleccionada"
               asp-route-q="@Model.Busqueda"
               asp-route-etiqueta="@(activa ? null : (int?)et.Id)">
                <span class="material-symbols-outlined">@(activa ? "close" : et.Icono)</span>@et.Nombre
            </a>
        }
    </div>
}

<h2 id="productos" class="tienda-section-title font-literata">Nuestros productos</h2>

@if (!Model.Productos.Any())
{
    <p class="tienda-empty">No encontramos productos con esa búsqueda.</p>
}

<form asp-controller="Tienda" asp-action="AgregarVarios" method="post" class="tienda-seleccion-form">
    @Html.AntiForgeryToken()
<div class="tienda-grid">
    @foreach (var p in Model.Productos)
    {
        var precio = Model.EsRevendedor ? p.PrecioReventa : p.PrecioFinal;
        <div class="tienda-card @(p.EstaSinStockEnTienda ? "agotado" : "")">
            <a class="tc-link" asp-controller="Tienda" asp-action="Detalle" asp-route-id="@p.Id">
                <div class="tc-img">
                    @if (!string.IsNullOrEmpty(p.ImagenURL))
                    {
                        <img src="@p.ImagenURL" alt="@p.NombreVisible" loading="lazy" />
                    }
                    else
                    {
                        <span class="material-symbols-outlined tc-placeholder">bakery_dining</span>
                    }
                    @if (p.EstaSinStockEnTienda)
                    {
                        <span class="tc-tag agotado">Sin stock</span>
                    }
                    else if (p.PorEncargo)
                    {
                        <span class="tc-tag">Por encargo</span>
                    }
                    else
                    {
                        <span class="tc-tag disponible">En stock</span>
                    }
                    <span class="tc-ver-detalle">
                        <span class="material-symbols-outlined">visibility</span> Ver detalles
                    </span>
                </div>
                <div class="tc-body">
                    <div class="tc-name">@p.NombreVisible</div>
                    @if (p.Categoria != null)
                    {
                        <div class="tc-meta">@p.Categoria.Nombre</div>
                    }
                    <div class="tc-price">$@precio.ToString("N0", ar)</div>
                </div>
            </a>
            @if (!p.EstaSinStockEnTienda)
            {
                <div class="tc-agregar">
                    <div class="stepper-tienda sm">
                        <button type="button" aria-label="Restar" onclick="cambiarCantidadCard(this, -1)">
                            <span class="material-symbols-outlined">remove</span>
                        </button>
                        <input type="text" name="cantidades[@p.Id]" value="0" readonly />
                        <button type="button" aria-label="Sumar" onclick="cambiarCantidadCard(this, 1)">
                            <span class="material-symbols-outlined">add</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>
    <div id="finSeleccionTienda" aria-hidden="true"></div>
    <div class="tienda-confirmar-seleccion">
        <span id="seleccionResumen">0 productos seleccionados</span>
        <button id="confirmarSeleccion" type="submit" disabled>
            Ver pedido <span class="material-symbols-outlined">shopping_cart</span>
        </button>
    </div>
</form>

@section Scripts {
    <script>
        function cambiarCantidadCard(btn, delta) {
            const input = btn.closest('.stepper-tienda').querySelector('input');
            const valor = parseInt(input.value, 10) || 0;
            input.value = Math.min(50, Math.max(0, valor + delta));
            actualizarSeleccion();
        }

        function actualizarSeleccion() {
            const cantidad = Array.from(document.querySelectorAll('.tienda-seleccion-form .stepper-tienda input'))
                .reduce((total, input) => total + (parseInt(input.value, 10) || 0), 0);
            const boton = document.getElementById('confirmarSeleccion');
            document.getElementById('seleccionResumen').textContent =
                `${cantidad} producto${cantidad === 1 ? '' : 's'} seleccionado${cantidad === 1 ? '' : 's'}`;
            boton.disabled = cantidad === 0;
        }

        const barraSeleccion = document.querySelector('.tienda-confirmar-seleccion');
        const finSeleccion = document.getElementById('finSeleccionTienda');
        new IntersectionObserver(([entrada]) => {
            barraSeleccion.classList.toggle('en-posicion-final', entrada.isIntersecting);
        }).observe(finSeleccion);
    </script>
}
