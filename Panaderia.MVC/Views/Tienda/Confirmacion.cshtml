@{
    Layout = "_TiendaLayout";
    ViewData["Title"] = "Pedido confirmado";
    var ar = new System.Globalization.CultureInfo("es-AR");
    var fechaEntrega = ViewBag.FechaEntrega as DateTime?;
    var esRetiro = (ViewBag.Entrega as string) == "retiro";
    var esTransferencia = (ViewBag.MedioPago as string) == "transferencia";
    var fechaTexto = fechaEntrega.HasValue ? fechaEntrega.Value.ToString("dddd d 'de' MMMM", ar) : "el sábado";
    var linkWhatsApp = ViewBag.LinkWhatsApp as string;
}

<div class="tienda-confirmacion" data-whatsapp-url="@linkWhatsApp">
    <div class="conf-icono">
        <span class="material-symbols-outlined">check_circle</span>
    </div>
    <h1 class="font-literata">¡Pedido confirmado!</h1>

    @if (esRetiro)
    {
        <p class="conf-texto">
            Retiralo el <b>@fechaTexto</b> en <b>Kiosco Suyay</b> (San Martín 888),<br />
            de 10 a 12:30 o de 16:30 a 22 hs.
        </p>
    }
    else
    {
        <p class="conf-texto">
            Te lo llevamos el <b>@fechaTexto</b> de 10:30 a 12:30 hs.<br />
            Coordinamos por WhatsApp.
        </p>
    }

    @if (esTransferencia)
    {
        <div class="entrega-banner" style="margin: 14px 0; text-align: left;">
            <span class="material-symbols-outlined">account_balance</span>
            <div>
                <b style="text-transform: none;">Alias para transferir: masaviva.pan</b>
                <small>Envianos el comprobante por WhatsApp.</small>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(linkWhatsApp))
    {
        <p class="conf-texto">
            Estamos abriendo WhatsApp con el detalle de tu pedido.<br />
            <b>Tocá enviar</b> para que nos llegue.
        </p>

        <a class="btn-mv-secondary carrito-cta" asp-controller="Tienda" asp-action="Index">Volver a la tienda</a>
    }
    else
    {
        <p class="conf-texto">Te vamos a escribir por WhatsApp para confirmar.</p>
        <a class="btn-mv-primary carrito-cta" asp-controller="Tienda" asp-action="Index">Volver a la tienda</a>
    }
</div>

@section Scripts {
    <script>
        // Abrir en la misma pestaña para no depender de ventanas emergentes.
        (function () {
            const url = document.querySelector('.tienda-confirmacion').dataset.whatsappUrl;
            if (!url) return;

            // Una sola vez por pedido: si el cliente recarga, no se vuelve a abrir
            const clave = 'mv_wa_@ViewBag.PedidoId';
            try {
                if (sessionStorage.getItem(clave)) return;
                sessionStorage.setItem(clave, '1');
            } catch (e) { /* modo privado: seguimos igual */ }

            const esMovil = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent)
                || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

            if (esMovil) {
                // El esquema de la app evita la página intermedia de wa.me.
                // El sistema puede pedir permiso antes de abrir WhatsApp.
                const enlace = new URL(url);
                const telefono = enlace.pathname.replace(/\//g, '');
                window.location.assign('whatsapp://send?phone=' + encodeURIComponent(telefono)
                    + '&text=' + encodeURIComponent(enlace.searchParams.get('text') || ''));
            } else {
                window.location.assign(url);
            }
        })();
    </script>
}
