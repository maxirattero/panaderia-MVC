@model Panaderia.Models.Entities.Producto
@{
    Layout = "_TiendaLayout";
    ViewData["Title"] = Model.NombreVisible;
    var ar = new System.Globalization.CultureInfo("es-AR");
    var precio = ViewBag.EsRevendedor is true ? Model.PrecioReventa : Model.PrecioFinal;
}

@if (TempData["TiendaMsg"] != null)
{
    <div class="tienda-toast">
        <span class="material-symbols-outlined">info</span> @TempData["TiendaMsg"]
    </div>
}

<div class="tienda-detalle">
    <a class="td-volver" asp-controller="Tienda" asp-action="Index">
        <span class="material-symbols-outlined">arrow_back</span> Volver a la tienda
    </a>

    <div class="td-grid">
        <div class="td-img">
            @if (!string.IsNullOrEmpty(Model.ImagenURL))
            {
                <img src="@Model.ImagenURL" alt="@Model.NombreVisible" />
            }
            else
            {
                <span class="material-symbols-outlined tc-placeholder">bakery_dining</span>
            }
        </div>

        <div class="td-info">
            <h1 class="font-literata">@Model.NombreVisible</h1>

            @if (Model.Categoria != null)
            {
                <div class="td-cat">
                    @Model.Categoria.Nombre@(Model.Tamano != null ? $" · {Model.Tamano.Descripcion}" : "")
                </div>
            }

            <div class="td-price">$@precio.ToString("N0", ar)</div>

            <div class="td-badges">
                @foreach (var etiqueta in Model.Etiquetas)
                {
                    <a class="badge-tienda" asp-controller="Tienda" asp-action="Index" asp-route-etiqueta="@etiqueta.Id">
                        <span class="material-symbols-outlined">@etiqueta.Icono</span> @etiqueta.Nombre
                    </a>
                }
                @if (Model.EstaSinStockEnTienda)
                {
                    <span class="badge-tienda agotado"><span class="material-symbols-outlined">block</span> Sin stock</span>
                }
                else if (Model.PorEncargo)
                {
                    <span class="badge-tienda"><span class="material-symbols-outlined">schedule</span> Por encargo</span>
                }
                else
                {
                    <span class="badge-tienda ok"><span class="material-symbols-outlined">check_circle</span> En stock</span>
                }
            </div>

            @if (Model.EstaSinStockEnTienda)
            {
                <p class="td-nota">Este producto está temporalmente sin stock. Volvé a mirar en unos días o consultanos cuándo vuelve.</p>
            }
            else
            {
                <form asp-controller="Tienda" asp-action="Agregar" method="post" class="td-agregar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="td-cantidad">
                        <span class="td-cantidad-label">Cantidad</span>
                        <div class="stepper-tienda">
                            <button type="button" aria-label="Restar" onclick="cambiarCantidad(-1)">
                                <span class="material-symbols-outlined">remove</span>
                            </button>
                            <input type="text" name="cantidad" id="cantidadInput" value="1" readonly />
                            <button type="button" aria-label="Sumar" onclick="cambiarCantidad(1)">
                                <span class="material-symbols-outlined">add</span>
                            </button>
                        </div>
                    </div>
                    <button type="submit" class="btn-mv-primary td-cta">
                        <span class="material-symbols-outlined">add_shopping_cart</span> Agregar al carrito
                    </button>
                </form>
                <p class="td-nota">Entrega los sábados de 10:30 a 12:30 hs — delivery sin cargo o retiro en el punto de entrega.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cambiarCantidad(delta) {
            const input = document.getElementById('cantidadInput');
            let valor = parseInt(input.value, 10) || 1;
            valor = Math.min(50, Math.max(1, valor + delta));
            input.value = valor;
        }
    </script>
}
