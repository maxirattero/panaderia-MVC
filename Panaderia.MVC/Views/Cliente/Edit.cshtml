@model EditarClienteViewModel

@{
    ViewData["Title"] = "Editar Cliente";
}

<!-- Heading -->
<div class="mb-4">
    <h2 class="font-literata fw-bold titulo-pagina">Editar Cliente</h2>
</div>

<div class="card card-custom p-4 mb-4">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="Id" type="hidden" />
            <div class="col-md-6">
                <label asp-for="Nombre" class="form-label small fw-bold text-muted">Nombre <span class="text-danger">*</span></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej. Juan" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Apellido" class="form-label small fw-bold text-muted">Apellido</label>
                <input asp-for="Apellido" class="form-control" placeholder="Ej. García" />
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Direccion" class="form-label small fw-bold text-muted">Dirección</label>
                <input asp-for="Direccion" class="form-control" placeholder="Calle, Número..." />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Localidad" class="form-label small fw-bold text-muted">Localidad</label>
                <input asp-for="Localidad" class="form-control" placeholder="Ej. Marcos Juárez" />
                <span asp-validation-for="Localidad" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Provincia" class="form-label small fw-bold text-muted">Provincia</label>
                <input asp-for="Provincia" class="form-control" placeholder="Ej. Córdoba" />
                <span asp-validation-for="Provincia" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Telefono" class="form-label small fw-bold text-muted">Teléfono</label>
                <input asp-for="Telefono" class="form-control" placeholder="+54 000 000000" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>
            <div class="col-12">
                <div class="form-check mb-3"><input asp-for="PrecioDeCosto" class="form-check-input" /><label asp-for="PrecioDeCosto" class="form-check-label"></label></div>
                <div class="form-text mb-3">El precio de costo reemplaza el precio habitual y los descuentos en los pedidos nuevos o editados.</div>
                </div>
            <div class="col-md-3">
                <label asp-for="DescuentoPorcentaje" class="form-label small fw-bold text-muted">Descuento habitual</label>
                <div class="input-group">
                    <input asp-for="DescuentoPorcentaje" type="number" min="0" max="100" step="0.01"
                           class="form-control" placeholder="Sin descuento" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="DescuentoPorcentaje" class="text-danger"></span>
                <div class="form-text">Se autocompleta al crear un pedido de este cliente.</div>
            </div>
            <div class="col-md-3 d-flex align-items-center">
                <div class="form-check">
                    <input asp-for="Revendedor" class="form-check-input" type="checkbox" />
                    <label asp-for="Revendedor" class="form-check-label small fw-bold text-muted">Revendedor</label>
                </div>
            </div>
        </div>

        <section class="mt-4 pt-4 border-top">
            <h3 class="h5 fw-bold">Acceso a la tienda</h3>
            <div class="form-check form-switch mb-3">
                <input asp-for="AccesoTienda" class="form-check-input" role="switch" />
                <label asp-for="AccesoTienda" class="form-check-label">Habilitar acceso a la tienda</label>
            </div>
            <p class="small text-muted">Disponible para revendedores. Deshabilitar el acceso cierra sus sesiones y conserva su cuenta y sus pedidos.</p>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="EmailAcceso" class="form-label">Usuario (correo electrónico)</label>
                    <input asp-for="EmailAcceso" class="form-control" type="email" autocomplete="off" />
                    <span asp-validation-for="EmailAcceso" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NuevaPassword" class="form-label">Nueva contraseña</label>
                    <input asp-for="NuevaPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NuevaPassword" class="text-danger"></span>
                    <div class="form-text">Dejala vacía para conservar la actual. Para un acceso nuevo, ingresá al menos 10 caracteres, una minúscula y un número.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmarPassword" class="form-label">Repetir nueva contraseña</label>
                    <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
                </div>
            </div>
        </section>

        <!-- Action Buttons -->
        <div class="d-flex flex-column flex-md-row justify-content-end gap-3 mt-5 pt-4 border-top">
            <button type="submit" class="btn btn-mv-primary d-flex align-items-center justify-content-center gap-2">
                <span class="material-symbols-outlined">save</span>Guardar
            </button>
            <a asp-action="Index" class="btn btn-mv-tertiary">Cancelar</a>
        </div>
    </form>
</div>