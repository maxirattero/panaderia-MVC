@model Panaderia.Models.Entities.ProductoMaterial
@using Panaderia.Models.Entities
@using System.Globalization
@{
    var indice = (string)ViewData["IndiceMaterial"]!;
    var insumos = ViewBag.InsumosMateriales as List<Insumo> ?? [];
}
<tr>
    <td>
        <label class="visually-hidden" for="material-@indice">Material adicional</label>
        <select name="Materiales[@indice].IdInsumo" id="material-@indice" class="form-select material-insumo" required>
            <option value="">Elegir material</option>
            @foreach (var insumo in insumos)
            { <option value="@insumo.Id" selected="@(insumo.Id == Model.IdInsumo)">@insumo.Nombre @(!insumo.Activo ? "(inactivo)" : "")</option> }
        </select>
        <span class="material-ayuda text-muted small"></span>
    </td>
    <td>
        <label class="visually-hidden" for="cantidad-material-@indice">Cantidad por producto</label>
        <input name="Materiales[@indice].Cantidad" id="cantidad-material-@indice" value="@Model.Cantidad.ToString("0.####", CultureInfo.InvariantCulture)" type="number" min="0.0001" max="999999.9999" step="0.0001" class="form-control material-cantidad" required />
    </td>
    <td class="material-subtotal text-nowrap">—</td>
    <td><button type="button" class="btn btn-sm btn-outline-danger quitar-material" aria-label="Quitar material">×</button></td>
</tr>
