<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Masa Viva</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <!-- Google Fonts: Literata & Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,200..900;1,7..72,200..900&amp;family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&amp;display=swap" rel="stylesheet" />
    <!-- Material Symbols Outlined -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
</head>
<body class="tienda-body">
    <header class="tienda-topbar">
        <a class="tt-brand" asp-controller="Tienda" asp-action="Index">
            <span class="tt-logo"><span class="material-symbols-outlined">bakery_dining</span></span>
            <span class="tt-name">
                <span class="font-literata">Masa Viva</span>
                <small>Fermento natural</small>
            </span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="tt-login" asp-controller="Home" asp-action="Index">
                <span class="material-symbols-outlined">space_dashboard</span>
                <span class="d-none d-sm-inline">Panel</span>
            </a>
        }
        else
        {
            <a class="tt-login" asp-controller="Account" asp-action="Login">
                <span class="material-symbols-outlined">person</span>
                <span class="d-none d-sm-inline">Ingresar</span>
            </a>
        }
    </header>

    <main class="tienda-main">
        @RenderBody()
    </main>

    <footer class="tienda-footer">
        <span class="font-literata">Masa Viva</span>
        <small>Pan de masa madre · Fermento natural</small>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
