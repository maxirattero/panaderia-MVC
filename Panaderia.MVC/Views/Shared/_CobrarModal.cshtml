<div class="modal fade" id="cobrarModal" tabindex="-1" aria-labelledby="cobrarModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-literata fw-bold titulo-pagina" id="cobrarModalLabel">
                    Registrar cobro
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="cobrarForm" method="post">
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdPedido" id="cobrarIdPedido" />
                    <input type="hidden" name="Clave" id="claveCobro" value="@Guid.NewGuid()" />
                    <div class="mb-3">
                        <label for="cobrarMonto" class="form-label small fw-bold text-muted">Monto a cobrar</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" step="0.01" min="0.01" name="Monto" id="cobrarMonto"
                                   class="form-control" required lang="en" />
                        </div>
                    </div>
                    <label class="form-label" for="cuentaCobro">Medio de cobro</label>
                    <select name="Cuenta" id="cuentaCobro" class="form-select mb-3" required>
                        <option value="">Elegí cómo pagó</option>
                        <option value="1">Efectivo</option>
                        <option value="2">Transferencia bancaria</option>
                    </select>
                    <label class="form-label" for="fechaCobro">Fecha y hora (opcional)</label>
                    <input type="datetime-local" id="fechaCobro" name="Fecha" class="form-control mb-2" />
                    <span class="d-block small text-muted mb-3">Si la dejás vacía, se registra ahora.</span>
                    <p class="small text-muted mb-0">
                        Saldo pendiente: <strong id="cobrarSaldo"></strong>
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-mv-tertiary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined">payments</span>Confirmar cobro
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
