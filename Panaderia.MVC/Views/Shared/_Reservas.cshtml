@model Panaderia.Models.DTOs.FinanciacionResumen
@using Panaderia.MVC.Models
@using System.Globalization
@foreach (var reserva in Model.Reservas)
{
    var pendiente = reserva.Monto - Model.Pagos.Where(x => x.IdReserva == reserva.Id).Sum(x => x.Monto);
    if (pendiente <= 0) { continue; }
    <div class="border-top pt-3 mt-3"><p><strong>@reserva.Aporte.Origen · Compra #@reserva.Aporte.IdCompra</strong> · Cierre @reserva.Cierre.InicioSemana.ToString("dd/MM/yyyy") · Pendiente: @CajaUi.Moneda(pendiente)</p>
        <form asp-controller="Financiacion" asp-action="Pagar" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()<input type="hidden" name="Aporte" value="@reserva.IdAporte" /><input type="hidden" name="Reserva" value="@reserva.Id" /><input type="hidden" name="Clave" value="@Guid.NewGuid()" />
            <div class="col-sm-4"><label for="cuentaReserva-@reserva.Id" class="form-label">Cuenta de Masa Viva</label><select name="Cuenta" id="cuentaReserva-@reserva.Id" class="form-select" required><option value="">Elegir cuenta</option><option value="1">Efectivo</option><option value="2">Banco</option></select></div>
            <div class="col-sm-4"><label for="montoReserva-@reserva.Id" class="form-label">Importe pagado</label><input name="Monto" id="montoReserva-@reserva.Id" type="number" step="0.01" min="0.01" max="@pendiente.ToString(CultureInfo.InvariantCulture)" value="@pendiente.ToString("0.00", CultureInfo.InvariantCulture)" class="form-control" required /></div>
            <div class="col-sm-4"><button class="btn btn-mv-primary">Confirmar reintegro pagado</button></div>
        </form>
    </div>
}
