@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@inject IConfiguration Configuration
@{
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var vapidPublicKey = Configuration["PushNotifications:VapidPublicKey"];
}
<button class="btn d-lg-none me-2" data-bs-toggle="offcanvas" data-bs-target="#sidebarMobile">
    <span class="material-symbols-outlined">menu</span>
</button>
<button class="btn p-1 text-secondary d-none d-lg-block" id="btnToggleSidebar">
    <span class="material-symbols-outlined">menu</span>
</button>
<div class="me-auto"></div>
<div class="d-flex align-items-center gap-2">
    @if (User.IsInRole("Admin"))
    {
        <div class="dropdown" id="notificacionesPedidos"
             data-user-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value"
             data-feed-url="@Url.Action("PedidosRecientes", "NotificacionPush")"
             data-detail-url="@Url.Action("Details", "Pedido")">
            <button id="btnPedidosNuevos" class="admin-topbar-action" type="button"
                    data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                    aria-label="Pedidos nuevos" title="Pedidos nuevos">
                <span class="material-symbols-outlined">notifications</span>
                <span id="contadorPedidosNuevos" class="tt-cart-badge" hidden></span>
            </button>
            <div class="dropdown-menu dropdown-menu-end pedidos-notificaciones">
                <div class="px-3 py-2 border-bottom">
                    <strong>Pedidos nuevos</strong>
                    <div class="small text-muted">Últimos 7 días · hasta 20 pedidos</div>
                </div>
                <p id="estadoPedidosNuevos" class="small px-3 pt-2 mb-2" role="status" aria-live="polite">Buscando pedidos…</p>
                <div id="listaPedidosNuevos" class="pedidos-notificaciones-lista"></div>
                <div class="px-3 py-2 border-top d-flex flex-wrap gap-2">
                    <button id="marcarPedidosVistos" class="btn btn-sm btn-outline-secondary" type="button" disabled>Marcar todos como vistos</button>
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Pedido" asp-action="Index">Ver todos</a>
                    <button id="btnNotificacionesPush" class="btn btn-sm btn-outline-secondary" type="button"
                            data-vapid-public-key="@vapidPublicKey" data-antiforgery-token="@csrfToken">
                        Activar / probar avisos del dispositivo
                    </button>
                </div>
            </div>
        </div>
    }
    <a class="admin-topbar-action" asp-controller="Tienda" asp-action="Index"
       title="Ir a la tienda" aria-label="Ir a la tienda">
        <span class="material-symbols-outlined">shopping_cart</span>
    </a>
</div>
