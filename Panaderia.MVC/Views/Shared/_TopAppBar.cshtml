@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@inject IConfiguration Configuration
@{
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var vapidPublicKey = Configuration["PushNotifications:VapidPublicKey"];
}
<button class="btn d-lg-none me-2" data-bs-toggle="offcanvas" data-bs-target="#sidebarMobile">
    <span class="material-symbols-outlined">menu</span>
</button>
<button class="btn p-1 text-secondary d-none d-lg-block" id="btnToggleSidebar">
    <span class="material-symbols-outlined">menu</span>
</button>
<div class="me-auto"></div>
<div class="d-flex align-items-center gap-3">
    <button id="btnNotificacionesPush" class="btn p-1 text-secondary" type="button" title="Activar notificaciones"
            data-vapid-public-key="@vapidPublicKey" data-antiforgery-token="@csrfToken">
        <span class="material-symbols-outlined">notifications</span>
    </button>
    <a class="btn btn-sm btn-mv-secondary d-flex align-items-center gap-1" asp-controller="Tienda" asp-action="Index"
       title="Ir a la tienda" aria-label="Ir a la tienda">
        <span class="material-symbols-outlined">storefront</span>
        <span class="d-none d-sm-inline">Tienda</span>
    </a>
</div>
